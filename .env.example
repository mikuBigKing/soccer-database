# 本地开发：复制本文件为 .env 后按需修改；生产必须显式设置真实值。
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# sqlite | mysql
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# MySQL 时生效
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

MAX_FILE_SIZE=10485760
MAX_IMAGE_SIZE=10485760

# 前后端分域部署时允许的前端源（逗号分隔；同源反向代理部署可留空）
CORS_ALLOWED_ORIGINS=http://localhost:8083,http://127.0.0.1:8083

# ---------------------------------------------------------------------------
# 赛事报告 AI（Qwen3 / DashScope OpenAI 兼容端点）
# REPORT_LLM_MOCK 未显式设置时：有 API Key 走真实调用，无 Key 自动 mock
# ---------------------------------------------------------------------------
REPORT_ENABLED=1
REPORT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REPORT_LLM_API_KEY=
REPORT_LLM_MODEL=qwen3-max
REPORT_LLM_TIMEOUT=60
REPORT_LLM_TEMPERATURE=0.3
REPORT_LLM_MAX_TOKENS=2000
REPORT_LLM_DISABLE_THINKING=1
REPORT_LLM_MOCK=1

# ---------------------------------------------------------------------------
# 邮件 / 邮箱验证码
# 开发默认 console 后端；生产填 SMTP 后自动切换
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.exmail.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_HOST_USER=no-reply@yourdomain.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=赛事系统 <no-reply@yourdomain.com>
VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_CODE_COOLDOWN_SECONDS=60
VERIFICATION_CODE_HOURLY_LIMIT=5
VERIFICATION_CODE_DAILY_LIMIT=10
VERIFICATION_CODE_MAX_ATTEMPTS=5
