DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# sqlite | mysql
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# MySQL 时生效
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

MAX_FILE_SIZE=10485760
MAX_IMAGE_SIZE=10485760

# ---------------------------------------------------------------------------
# 赛事报告 AI（Qwen3 / DashScope OpenAI 兼容端点）
# REPORT_LLM_MOCK 未显式设置时：有 API Key 走真实调用，无 Key 自动 mock
# ---------------------------------------------------------------------------
REPORT_ENABLED=1
REPORT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REPORT_LLM_API_KEY=
REPORT_LLM_MODEL=qwen3-max
REPORT_LLM_TIMEOUT=60
REPORT_LLM_TEMPERATURE=0.3
REPORT_LLM_MAX_TOKENS=2000
REPORT_LLM_DISABLE_THINKING=1
REPORT_LLM_MOCK=1

