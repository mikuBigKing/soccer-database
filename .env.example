# 本地开发：复制本文件为 .env 后按需修改；生产必须显式设置真实值。
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# sqlite | mysql
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# MySQL 时生效
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

MAX_FILE_SIZE=10485760
MAX_IMAGE_SIZE=10485760

# 前后端分域部署时允许的前端源（逗号分隔；同源反向代理部署可留空）
CORS_ALLOWED_ORIGINS=http://localhost:8083,http://127.0.0.1:8083
